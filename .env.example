# GNews API key for tech news integration
GNEWS_API_KEY=your_gnews_api_key_here

# JWT Secret Key (required in production)
JWT_SECRET=generate_strong_64_char_hex_secret_here

# Environment ('development' or 'production')
ENVIRONMENT=development

# Allowed CORS origins (comma-separated, optional)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend backend proxy target (optional, defaults to http://localhost:8000)
API_URL=http://localhost:8000

